---
import DetailPage from '../layouts/DetailPage.astro';
import { translate, withBase } from '../lib/i18n';
const { lang, work } = Astro.props;
const t = (key: string) => translate(lang, key);
---
<DetailPage lang={lang} type="image" slug={work.slug} title={work.title} description={work.description} label={t('imageWork')} date={work.created} dateLabel={work.dateLabel} artwork={work}>
  <figure class="detail-figure image-work-figure">
    <img src={withBase(work.image)} width={work.width} height={work.height} alt={work.alt} decoding="async" fetchpriority="high" />
    <figcaption>{work.credit}</figcaption>
  </figure>
  <div class="detail-media-link image-work-original"><a class="reading-back u-grow" href={withBase(work.image)} target="_blank" rel="noopener">{t('viewOriginalImage')} ↗</a></div>
</DetailPage>
