---
import DetailPage from '../layouts/DetailPage.astro';
import { translate, withBase } from '../lib/i18n';
const { lang, work } = Astro.props;
const t = (key: string) => translate(lang, key);
---
<DetailPage lang={lang} type="project" slug={work.slug} title={work.title} description={work.description} label={work.label} date={work.created} dateLabel={work.dateLabel} project={work}>
  <div class="project-overview">{work.overview.split(/\n\s*\n/).map((paragraph: string) => <p>{paragraph}</p>)}</div>
  {work.features.length > 0 && <><h2>{t('projectFeatures')}</h2>
  <ul>{work.features.map((feature: string) => <li>{feature}</li>)}</ul></>}
  {work.gallery.length > 0 ? <div class="project-gallery">
    {work.gallery.map((item: {image: string; preview?: string; width: number; height: number; alt: string; caption: string}) => <section class="project-gallery-item">
      <h2>{item.caption}</h2>
      <figure class="detail-figure project-work-figure">
        <a href={withBase(item.image)} target="_blank" rel="noopener noreferrer" aria-label={item.caption + ' · ' + t('viewOriginalImage')}>
          <img src={withBase(item.preview || item.image)} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" />
        </a>
      </figure>
      <div class="detail-media-link"><a class="reading-back" href={withBase(item.image)} target="_blank" rel="noopener noreferrer">{t('viewOriginalImage')} ↗</a></div>
    </section>)}
  </div> : <figure class="detail-figure project-work-figure">
    <img src={withBase(work.image)} width={work.width} height={work.height} alt={work.alt} decoding="async" />
    <figcaption>{t('projectPreviewCaption')}</figcaption>
  </figure>}
  {work.sources.length > 0 ? <p slot="source">{t('projectSource')} {work.sources.map((source: {url?: string; label: string}, index: number) => <>{index > 0 && ' · '}<span class="project-source-item">{source.url ? <a class="detail-source-link project-source-link u-grow" href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a> : source.label}</span></>)}</p> : work.external_url && <p slot="source">{t('projectSource')} <a class="detail-source-link project-work-link u-grow" href={work.external_url} target="_blank" rel="noopener noreferrer">{t('viewOnAgensi')} ↗</a></p>}
</DetailPage>
