---
import DetailPage from '../layouts/DetailPage.astro';
import { render } from 'astro:content';
import { translate } from '../lib/i18n';
import { formatWorkDate } from '../data/works';
const { lang, note } = Astro.props;
const { frontmatter: meta, entry } = note;
const { Content } = await render(entry);
---
<DetailPage lang={lang} type="text" slug={note.slug} title={meta.heading} pageTitle={meta.pageTitle} description={meta.description} label={translate(lang, meta.kind === 'letter' ? 'letterNote' : 'readingNote')} date={meta.date} dateLabel={formatWorkDate(meta.date, lang)} published={meta.date} source={meta.source}>
  <Content />
</DetailPage>
