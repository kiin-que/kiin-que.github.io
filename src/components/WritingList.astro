---
import { getWorks } from '../data/works';
import { translate, localPath, withBase } from '../lib/i18n';
const { lang } = Astro.props;
const t = (key: string) => translate(lang, key);
const works = await getWorks(lang);
---
<ul class="writing-list" id="writing-list">
{works.map(work => <li class:list={['writing-entry', {'writing-entry-image': Boolean(work.image), 'writing-entry-project': work.type === 'project'}]} data-writing-category={work.category}>
  <a class="writing-entry-link" href={localPath(lang, work.path)}>
    <div class="writing-entry-text">
      <p class="writing-meta"><span>{t(work.label)}</span>{work.date && <time datetime={work.date}>{work.dateLabel}</time>}</p>
      <h3 class="writing-title">{work.title}</h3>
    </div>
    {work.image && <img class="writing-thumbnail" src={withBase(work.image)} width={work.width} height={work.height} alt={work.alt} loading="lazy" decoding="async" />}
  </a>
</li>)}
</ul>
