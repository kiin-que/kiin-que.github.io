---
import ReadingNote from '../../components/ReadingNote.astro';
import { getNotes } from '../../data/notes';
export function getStaticPaths() {
  return getNotes('ko').map(note => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
---
<ReadingNote lang="ko" note={note} />
