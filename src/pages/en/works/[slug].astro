---
import ImageWork from '../../../components/ImageWork.astro';
import { getImageWorks } from '../../../data/works';
export async function getStaticPaths() {
  return (await getImageWorks('en')).map(work => ({params: {slug: work.slug}, props: {work}}));
}
const {work} = Astro.props;
---
<ImageWork lang="en" work={work} />
