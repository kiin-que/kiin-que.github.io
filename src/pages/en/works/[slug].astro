---
import ProjectWork from '../../../components/ProjectWork.astro';
import ImageWork from '../../../components/ImageWork.astro';
import { getDetailedWorks } from '../../../data/works';
export async function getStaticPaths() {
  return (await getDetailedWorks('en')).map(work => ({params: {slug: work.slug}, props: {work}}));
}
const {work} = Astro.props;
---
{work.kind === 'project' ? <ProjectWork lang="en" work={work} /> : <ImageWork lang="en" work={work} />}
