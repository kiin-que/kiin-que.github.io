---
import ReadingNote from '../../../components/ReadingNote.astro';
import { getNotes } from '../../../data/notes';
export async function getStaticPaths() {
  return (await getNotes('en')).map(note => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
---
<ReadingNote lang="en" note={note} />
