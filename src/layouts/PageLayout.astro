---
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { withBase, localPath, clientMessages } from '../lib/i18n';
import { asset } from '../lib/assets';
import type { Language } from '../lib/i18n';
const {lang, title, description, article = false, slug = '', published, artwork} = Astro.props as {
  lang: Language; title: string; description: string; article?: boolean; slug?: string; published?: string;
  artwork?: {image: string; created: string; tool: string; mime: string};
};
const detailSection = artwork ? 'works' : 'writing';
const tail = article ? detailSection + '/' + slug + '/' : '';
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(localPath(lang, tail));
const image = absolute(withBase(artwork ? artwork.image : 'assets/portrait-soft.png'));
const schema = artwork ? {
  '@context': 'https://schema.org', '@type': 'VisualArtwork', name: title.replace(/ · Ki In$/, ''), description,
  dateCreated: artwork.created, inLanguage: lang, url: canonical, image,
  artMedium: 'AI-generated image (' + artwork.tool + ')', encodingFormat: artwork.mime,
} : article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  datePublished: published, inLanguage: lang, mainEntityOfPage: canonical, image,
  author: {'@type': 'Person', name: 'Ki In', url: absolute(localPath(lang))},
} : {
  '@context': 'https://schema.org', '@type': 'ProfilePage', inLanguage: lang, url: canonical,
  mainEntity: {'@type': 'Person', name: 'Ki In', image},
};
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\u003c');
---
<!doctype html>
<html lang={lang} class={'lang-' + lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F8F1E7" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ko" href={absolute(localPath('ko', tail))} />
  <link rel="alternate" hreflang="en" href={absolute(localPath('en', tail))} />
  <link rel="alternate" hreflang="x-default" href={absolute(localPath('ko', tail))} />
  <meta property="og:type" content={article && !artwork ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content={artwork ? 'summary_large_image' : 'summary'} />
  {published && <meta property="article:published_time" content={published} />}
  <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  {['common.css', 'letter.css', 'reading.css', 'language.css'].map(file => <link rel="stylesheet" href={asset(file)} />)}
  <script type="application/ld+json" set:html={json(schema)} />
</head>
<body class={article ? 'reading-page' : 'letter-page'}>
  <Header lang={lang} article={article} slug={slug} detailSection={detailSection} />
  <slot />
  <SiteFooter lang={lang} article={article} />
  {!article && <><div id="letter-toast" class="letter-toast" role="status" hidden></div><script id="page-translations" type="application/json" set:html={json(clientMessages(lang))} /><script is:inline src={asset('letter.js')} defer></script></>}
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach(link => {
      link.addEventListener('click', () => { if (location.hash) link.hash = location.hash; });
    });
  </script>
</body>
</html>
